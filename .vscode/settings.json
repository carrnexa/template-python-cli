{
  /* Copilot */
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "file": ".github/commit-instructions.md"
    }
  ],

  /* Formatting */
  "editor.formatOnSave": true,

  /* Python */
  "python.testing.pytestEnabled": true,

  // Ruff
  "ruff.configurationPreference": "filesystemFirst",

  /* Even Better TOML */
  "evenBetterToml.formatter.allowedBlankLines": 1,
  "evenBetterToml.formatter.columnWidth": 100,
  "evenBetterToml.formatter.compactInlineTables": true,

  /* Markdown */
  "markdown.validate.enabled": true,

  /* XML */
  "xml.format.emptyElements": "collapse",
  "xml.format.enforceQuoteStyle": "preferred",
  "xml.format.preserveAttributeLineBreaks": false,
  "xml.format.preservedNewlines": 1,
  "xml.format.joinCommentLines": true,
  "xml.format.joinContentLines": true,
  "xml.format.maxLineWidth": 100,
  "redhat.telemetry.enabled": false,

  /* Associations */
  "files.associations": {
    // Plain Text
    "LICENSE*": "txt",

    // Markdown (overrides Copilot's instructions/prompt/agent/skill modes so markdownlint applies)
    "*.md": "markdown",

    // JSONC
    "*.manifest": "jsonc",
    "*.webmanifest": "jsonc",
    "*.code-snippets": "jsonc"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    "editor.unicodeHighlight.ambiguousCharacters": true,
    "editor.unicodeHighlight.invisibleCharacters": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml",
    "editor.tabSize": 2
  }
}
